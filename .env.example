# =============================================
# UaDay Cleaning — Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# Google Maps API Key (optional — required only for interactive maps)
# Get yours at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Analytics 4 Measurement ID
# Get yours at: https://analytics.google.com
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Site URL (used for SEO canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=https://uadaycleaning.com.au

# Contact form email destination (if using a form service)
# CONTACT_EMAIL=hello@uadaycleaning.com.au

# Email service API key (e.g. Resend, SendGrid)
# EMAIL_API_KEY=your_email_api_key_here

# =============================================
# AI Chatbot (24/7 website assistant, app/api/chat)
# =============================================

# Required — Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — override the default model (claude-sonnet-5). For a high-traffic
# FAQ bot, claude-haiku-4-5-20251001 is a cheaper, faster alternative.
# CHATBOT_MODEL=claude-sonnet-5

# Optional — where captured leads get sent. Set ONE or BOTH:

# A Slack "Incoming Webhook" URL (Slack > api.slack.com/messaging/webhooks),
# or a Zapier/Make/n8n webhook. Easiest option, ~2 minutes to set up.
# LEAD_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Email a lead notification via Resend (resend.com).
# RESEND_API_KEY=your_resend_api_key_here
# LEAD_NOTIFY_EMAIL=support@udaycleaning.com.au
# LEAD_NOTIFY_FROM=UDAY Cleaning Chatbot <onboarding@resend.dev>
